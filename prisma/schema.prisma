// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  shopDomain           String   @id
  initialSyncCompleted Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  shop      String
  type      String   // "OUT_OF_STOCK" | "LOW_STOCK" | "STOCKOUT_RISK"
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([shop])
  @@index([shop, read])
}

model BulkOperationJob {
  id                String   @id @default(cuid())
  shop              String
  type              String   // "PRODUCTS" | "ORDERS"
  bulkOperationGid  String   @unique // gid://shopify/BulkOperation/123 - matches admin_graphql_api_id from the webhook
  status            String   @default("RUNNING") // RUNNING | COMPLETED | FAILED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shop])
  @@index([status])
}

model Product {
  id           String    @id @default(cuid())
  shopifyId    String    @unique // gid://shopify/Product/123456789
  shop         String    // shopDomain, scopes this row to a merchant
  title        String
  handle       String?
  status       String?   // ACTIVE, DRAFT, ARCHIVED
  vendor       String?
  productType  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  variants     Variant[]
  @@index([shop])
}

model Variant {
  id               String   @id @default(cuid())
  shopifyId        String   @unique // gid://shopify/ProductVariant/123456789
  productShopifyId String   // FK to Product.shopifyId
  product          Product  @relation(fields: [productShopifyId], references: [shopifyId], onDelete: Cascade)
  title            String?
  sku              String?
  price            String?
  compareAtPrice   String?
  inventoryItemId  String?  // gid://shopify/InventoryItem/123456789 - links to InventoryItem
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  inventoryItem    InventoryItem? @relation(fields: [inventoryItemId], references: [shopifyId])

  @@index([productShopifyId])
  @@index([sku])
}

model InventoryItem {
  id         String   @id @default(cuid())
  shopifyId  String   @unique // gid://shopify/InventoryItem/123456789
  shop       String
  sku        String?
  tracked    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  variants   Variant[]
  levels     InventoryLevel[]

  @@index([shop])
}

model Location {
  id         String   @id @default(cuid())
  shopifyId  String   @unique // gid://shopify/Location/123456789
  shop       String
  name       String
  isActive   Boolean  @default(true)

  levels     InventoryLevel[]

  @@index([shop])
}

model InventoryLevel {
  id               String   @id @default(cuid())
  inventoryItemId  String   // FK to InventoryItem.shopifyId
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [shopifyId], onDelete: Cascade)
  locationId       String   // FK to Location.shopifyId
  location         Location @relation(fields: [locationId], references: [shopifyId], onDelete: Cascade)
  available        Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@unique([inventoryItemId, locationId]) // one row per item+location combo
  @@index([inventoryItemId])
  @@index([locationId])
}

model Order {
  id                 String   @id @default(cuid())
  shopifyId          String   @unique // gid://shopify/Order/123456789
  shop               String
  name               String   // e.g. "#1001"
  email              String?
  financialStatus    String?  // PAID, PENDING, REFUNDED, etc.
  fulfillmentStatus  String?  // FULFILLED, UNFULFILLED, PARTIAL, etc.
  totalAmount        String?
  currency            String?
  createdAt          DateTime
  updatedAt          DateTime @updatedAt

  lineItems          OrderLineItem[]

  @@index([shop])
  @@index([createdAt])
}

model OrderLineItem {
  id               String   @id @default(cuid())
  shopifyId        String   @unique // gid://shopify/LineItem/123456789
  orderShopifyId   String   // FK to Order.shopifyId
  order            Order    @relation(fields: [orderShopifyId], references: [shopifyId], onDelete: Cascade)
  variantShopifyId String?  // FK-ish to Variant.shopifyId (nullable - variant may be deleted)
  title            String
  quantity         Int
  price            String?

  @@index([orderShopifyId])
}
